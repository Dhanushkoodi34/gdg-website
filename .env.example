# Set to your public production URL for correct social sharing metadata.
NEXT_PUBLIC_SITE_URL=

# --- Firebase service account (server-side only, never prefix with NEXT_PUBLIC_) ---
# Get these from Firebase console > Project settings > Service accounts > Generate new private key.
# Project ID for this site is already correct.
FIREBASE_PROJECT_ID=gdg-event-ced32
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxxx@gdg-event-ced32.iam.gserviceaccount.com
# Paste the private_key field from the downloaded JSON. Keep the surrounding quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: defaults to eventRegistrations
FIREBASE_COLLECTION=eventRegistrations